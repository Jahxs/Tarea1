# ==============================================================================
# TaskHub - Backend Distributed Node Environment Template (.env)
# Target: Amazon Linux 2023 EC2 Node (Spring Boot 3 only - No local PostgreSQL)
# Copy this file to .env and configure real values. NEVER commit .env to GitHub.
# ==============================================================================

# Centralized PostgreSQL Database Server Configuration
# Provide the private IP, DNS, or RDS endpoint where the centralized DB is hosted
DB_HOST=10.0.1.50
DB_PORT=5432
DB_NAME=crud_tareas_db
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# Backend Service Port on EC2 Host (Default: 8080)
APP_PORT=8080

# Maximum HikariCP Connections per EC2 node (Recommended: 3 to 5 for t3.micro)
HIKARI_MAX_POOL=5
