# ==============================================================================
# Environment Variables Template - Docker / Production Environment
# Copy this file as .env and configure values for your target deployment.
# NEVER commit real passwords or the .env file to GitHub.
# ==============================================================================

# PostgreSQL Database Configuration (Required)
POSTGRES_DB=crud_tareas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Nginx Reverse Proxy Public HTTP Port
# Direct access to Spring Boot port 8080 has been revoked from the host interface.
NGINX_PORT=80

