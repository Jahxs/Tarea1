# PostgreSQL Database Configuration
POSTGRES_DB=crud_tareas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Spring Boot Application Host Port
APP_PORT=8080
