# ==============================================================================
# Plantilla de Variables de Entorno - Entorno Docker
# Copie este archivo como .env y configure los valores para su entorno.
# NUNCA suba el archivo .env con contraseñas reales a GitHub.
# ==============================================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=crud_tareas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Puerto de la Aplicación Spring Boot
APP_PORT=8080
